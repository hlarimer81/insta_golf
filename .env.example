# Copy to .env and fill in. .env is git-ignored.

# --- Script generation (npm run generate) ---
ANTHROPIC_API_KEY=sk-ant-...
# IG_HASHTAGS=#golf #golftips #golfswing #golflife #golftok

# --- Instagram publishing (npm run schedule -- run --live) ---
# IG Business/Creator account ID (not the @handle) and a long-lived token
# with instagram_basic + instagram_content_publish + pages_read_engagement.
IG_USER_ID=
IG_ACCESS_TOKEN=
# GRAPH_API_VERSION=v21.0
# IG_POLL_ATTEMPTS=30
# IG_POLL_INTERVAL_MS=10000

# --- AWS S3 (hosts the video for Instagram's public video_url) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# S3_PREFIX=reels/
# S3_URL_TTL=3600

# --- Cloud daily poster (npm run enqueue) ---
# CLOUD_QUEUE_KEY=queue.json   # S3 key for the cloud posting queue
# The Lambda itself reads the IG token from Secrets Manager (IG_TOKEN_SECRET),
# not from .env — see the "Cloud automation" section of the README.
